---
// src/pages/index.astro
const title = "Gottlieb Bustos Schulze | Portafolio & CV";
const description = "Ingeniero Civil en Informática con más de 15 años de trayectoria en Analítica de Datos, Control de Gestión TI y Dirección Estratégica.";

const contact = {
  email: "gottlieb.bustos@gmail.com",
  phone: "+56 9 6192 3633",
  location: "Temuco, Chile",
  languages: "Español (Nativo) · Inglés (B1)"
};

const skills = [
  { name: "Liderazgo Estratégico", icon: "fa-chart-line" },
  { name: "Análisis & Gobernanza de Datos", icon: "fa-database" },
  { name: "Gestión de Infraestructura", icon: "fa-server" },
  { name: "Desarrollo Web & PHP/JS", icon: "fa-code" },
  { name: "Automatización de Procesos", icon: "fa-gears" },
  { name: "Seguridad Informática", icon: "fa-shield-halved" },
  { name: "Optimización de Sistemas", icon: "fa-diagram-project" },
  { name: "Planificación Operativa", icon: "fa-clipboard-check" }
];

const experiences = [
  {
    period: "Feb 2023 - Oct 2025",
    role: "Subdirector Administrativo",
    org: "CESFAM Villa Alegre – Pedro Pastor Araya (Liderazgo Directivo y Gestión Estratégica)",
    achievements: [
      "Dirección General y Planificación: Organización integral de actividades administrativas y logísticas. Planes de continuidad con Cartas Gantt.",
      "Gobernanza Financiera: Formulación y control presupuestario anual junto al DSM y ejecución de auditorías de costos.",
      "Gestión de Personas: Supervisión del talento humano, cobertura de suplencias y precalificación de desempeño.",
      "Control de Procesos TI: Supervisión de adquisiciones, activos fijos y flujos tecnológicos institucionales.",
      "Gestión del Cambio: Promoción de ambientes laborales inclusivos, equidad de género y Plan Comunal de Capacitación."
    ]
  },
  {
    period: "Nov 2016 - Ene 2023",
    role: "Gestor de Información (Analista de Datos Clínicos y Sanitarios)",
    org: "CESFAM Villa Alegre – Pedro Pastor Araya",
    achievements: [
      "Análisis y Reportería: Gestión y entrega con 100% de oportunidad de informes estadísticos y sanitarios (REM/SIGGES).",
      "Data Quality: Auditorías de registro clínico electrónico e implementación de feedback loops con equipos de salud.",
      "Administración RAYEN Salud: Gestión de perfiles, seguridad por atributos y migración de datos.",
      "Base de Datos Poblacional: Control de Sis-Percapita y segmentación demográfica para decisiones directivas.",
      "Parametrización Clínica: Modelamiento de agendas electrónicas y reglas MAIS en flujos informáticos.",
      "Enlace Institucional: Representante técnico ante el SSASUR en mesas de reconciliación de datos."
    ]
  },
  {
    period: "Nov 2013 - Mar 2016",
    role: "Ingeniero de Soporte, Redes y Sistemas (Infraestructura de Datos)",
    org: "Valles del Sur S.p.A.",
    achievements: [
      "Administración ERP Softland: Soporte operativo resguardando integridad y consistencia de datos corporativos.",
      "CMDB y Activos: Documentación técnica centralizada y control de inventario TI.",
      "Continuidad y Backups: Políticas periódicas de respaldos ante contingencias.",
      "Infraestructura: Gestión de Windows Server 2008, servicios web y correo corporativo.",
      "SLAs y Mesa de Ayuda: Resolución y análisis de incidentes técnicos bajo métricas."
    ]
  },
  {
    period: "Oct 2013 - Nov 2016",
    role: "Desarrollador Web Freelance",
    org: "Buena Mezcla Estudio",
    achievements: [
      "Desarrollo Web: Implementación de soluciones a medida, arquitectura limpia y escalable.",
      "CMS & Backend: Personalización avanzada en WordPress, integración de APIs y desarrollo backend en PHP.",
      "Frontend & UX: Maquetación responsiva con CSS y analítica de rendimiento web."
    ]
  },
  {
    period: "Jun 2012 - Feb 2013",
    role: "Desarrollador de Aplicaciones / Ingeniero de Datos en Salud",
    org: "Hebrón Tecnología y Salud",
    achievements: [
      "Liderazgo Técnico: Mantenimiento y desarrollo de sistemas APS (GAP y GCP).",
      "Bases de Datos PostgreSQL: Modelamiento y optimización para registros clínicos sensibles.",
      "Fullstack: Lógica backend en PHP e interfaces dinámicas en JavaScript."
    ]
  }
];

const education = [
  { year: "2010 - 2014", title: "Ingeniería Civil en Informática", inst: "Universidad Tecnológica de Chile INACAP", highlight: true },
  { year: "Ene 2026", title: "Curso de Ciberseguridad para Redes de Datos", inst: "Universidad de Santiago de Chile" },
  { year: "Jun 2024", title: "Diplomado en Dirección Estratégica", inst: "Universidad Autónoma de Chile" },
  { year: "Nov 2023", title: "Diplomado en Entorno Estratégico", inst: "Universidad Autónoma de Chile" },
  { year: "Sep 2023", title: "Diplomado de Salud Pública", inst: "Capacitanet" },
  { year: "Nov 2022", title: "Diplomado en Dirección de Personas en Gobiernos Locales", inst: "Universidad del Desarrollo" },
  { year: "May 2020", title: "Diplomado de Gestión en Establecimientos de Salud", inst: "Incapnova Ltda." },
  { year: "Ene 2019", title: "Diplomado en Salud Familiar", inst: "Incapnova Ltda." },
  { year: "May 2015", title: "Diplomado en Administración de Base de Datos", inst: "Universidad Tecnológica de Chile INACAP" },
  { year: "Jun 2014", title: "Curso de Decisiones Estratégicas", inst: "Pontificia Universidad Católica de Chile" }
];
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="portfolio-body">

  <header class="portfolio-header">
    <nav class="portfolio-nav">
      <a href="#" class="nav-brand">Gottlieb Bustos S.</a>
      <div class="nav-links">
        <a href="#experiencia">Experiencia</a>
        <a href="#habilidades">Habilidades</a>
        <a href="#formacion">Formación</a>
      </div>
    </nav>
  </header>

  <div class="main-wrapper">
    <!-- Hero -->
    <section class="hero-block">
      <div class="badge-wrapper">
        <span class="hero-badge">Ingeniero Civil en Informática</span>
      </div>
      <h1 class="hero-name">Gottlieb Bustos Schulze</h1>
      <h2 class="hero-role">Analítica de Datos · Control de Gestión TI · Dirección Estratégica</h2>
      <p class="hero-desc">{description}</p>

      <div class="contact-grid">
        <a href={`mailto:${contact.email}`} class="contact-pill">
          <i class="fa-solid fa-envelope"></i> <span>{contact.email}</span>
        </a>
        <a href={`tel:${contact.phone.replace(/\s+/g, '')}`} class="contact-pill">
          <i class="fa-solid fa-phone"></i> <span>{contact.phone}</span>
        </a>
        <span class="contact-pill">
          <i class="fa-solid fa-location-dot"></i> <span>{contact.location}</span>
        </span>
        <span class="contact-pill">
          <i class="fa-solid fa-language"></i> <span>{contact.languages}</span>
        </span>
      </div>
    </section>

    <!-- Habilidades -->
    <section class="content-section" id="habilidades">
      <h2 class="heading-decorated">Habilidades Clave</h2>
      <div class="skills-grid">
        {skills.map((skill) => (
          <div class="skill-item">
            <i class={`fa-solid ${skill.icon}`}></i>
            <span>{skill.name}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Experiencia -->
    <section class="content-section" id="experiencia">
      <h2 class="heading-decorated">Experiencia Laboral</h2>
      <div class="timeline-container">
        {experiences.map((exp) => (
          <div class="timeline-entry">
            <div class="timeline-card-box">
              <span class="timeline-badge">{exp.period}</span>
              <h3 class="timeline-card-title">{exp.role}</h3>
              <p class="timeline-card-org">{exp.org}</p>
              <ul class="timeline-bullets">
                {exp.achievements.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Formación -->
    <section class="content-section" id="formacion">
      <h2 class="heading-decorated">Formación Académica & Diplomados</h2>
      <div class="edu-card-grid">
        {education.map((edu) => (
          <div class={`edu-item-box ${edu.highlight ? 'edu-highlight' : ''}`}>
            <span class="edu-item-year">{edu.year}</span>
            <h3 class="edu-item-title">{edu.title}</h3>
            <p class="edu-item-inst">{edu.inst}</p>
          </div>
        ))}
      </div>
    </section>
  </div>

  <footer class="portfolio-footer">
    <p>© 2026 Gottlieb Bustos Schulze · Portafolio Profesional</p>
  </footer>

</body>
</html>

<style is:global>
  /* Reset estricto para evitar colisiones con layouts de Astro */
  html, body.portfolio-body {
    margin: 0 !important;
    padding: 0 !important;
    background-color: #0f172a !important;
    color: #f8fafc !important;
    font-family: 'Inter', sans-serif !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }

  *, *::before, *::after {
    box-sizing: border-box !important;
  }

  .portfolio-header {
    width: 100%;
    background: rgba(15, 23, 42, 0.95);
    border-bottom: 1px solid #334155;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .portfolio-nav {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-brand {
    font-size: 1.15rem;
    font-weight: 700;
    color: #38bdf8;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
  }

  .nav-links a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: #38bdf8;
  }

  .main-wrapper {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
    display: block !important;
  }

  /* Hero */
  .hero-block {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    text-align: center !important;
    margin-bottom: 3.5rem !important;
    position: static !important;
  }

  .badge-wrapper {
    margin-bottom: 1rem;
  }

  .hero-badge {
    background: rgba(56, 189, 248, 0.12);
    color: #38bdf8;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    display: inline-block;
  }

  .hero-name {
    font-size: 2.6rem !important;
    font-weight: 800 !important;
    color: #ffffff !important;
    margin: 0 0 0.5rem 0 !important;
    line-height: 1.2 !important;
    position: static !important;
  }

  .hero-role {
    font-size: 1.2rem !important;
    font-weight: 600 !important;
    color: #38bdf8 !important;
    margin: 0 0 1.25rem 0 !important;
  }

  .hero-desc {
    max-width: 820px;
    color: #94a3b8;
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0 0 2rem 0;
  }

  .contact-grid {
    display: flex !important;
    flex-wrap: wrap !important;
    justify-content: center !important;
    gap: 0.85rem !important;
    margin-top: 0.5rem !important;
    position: static !important;
  }

  .contact-pill {
    background: #1e293b !important;
    border: 1px solid #334155 !important;
    color: #f8fafc !important;
    padding: 0.55rem 1rem !important;
    border-radius: 8px !important;
    font-size: 0.9rem !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.5rem !important;
    text-decoration: none !important;
  }

  .contact-pill i {
    color: #38bdf8;
  }

  /* Secciones */
  .content-section {
    margin-bottom: 4rem;
  }

  .heading-decorated {
    font-size: 1.75rem !important;
    font-weight: 700 !important;
    color: #ffffff !important;
    margin-bottom: 2rem !important;
    padding-bottom: 0.5rem !important;
    border-bottom: 3px solid #38bdf8 !important;
    display: inline-block !important;
  }

  /* Habilidades */
  .skills-grid {
    display: grid !important;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)) !important;
    gap: 1rem !important;
  }

  .skill-item {
    background: #1e293b;
    border: 1px solid #334155;
    padding: 1.15rem;
    border-radius: 10px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 600;
    color: #f8fafc;
  }

  .skill-item i {
    color: #38bdf8;
    font-size: 1.2rem;
  }

  /* Timeline Experiencia */
  .timeline-container {
    border-left: 2px solid #334155;
    margin-left: 0.5rem;
    padding-left: 1.75rem;
  }

  .timeline-entry {
    position: relative;
    margin-bottom: 2rem;
  }

  .timeline-entry::before {
    content: '';
    position: absolute;
    left: -2.25rem;
    top: 1.25rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #38bdf8;
  }

  .timeline-card-box {
    background: #1e293b;
    border: 1px solid #334155;
    padding: 1.5rem;
    border-radius: 10px;
  }

  .timeline-badge {
    color: #38bdf8;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.35rem;
  }

  .timeline-card-title {
    font-size: 1.2rem !important;
    font-weight: 700 !important;
    color: #ffffff !important;
    margin: 0 0 0.25rem 0 !important;
  }

  .timeline-card-org {
    color: #94a3b8;
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }

  .timeline-bullets {
    margin: 0;
    padding-left: 1.2rem;
    color: #94a3b8;
  }

  .timeline-bullets li {
    margin-bottom: 0.5rem;
    line-height: 1.5;
  }

  /* Formación */
  .edu-card-grid {
    display: grid !important;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)) !important;
    gap: 1.25rem !important;
  }

  .edu-item-box {
    background: #1e293b;
    border: 1px solid #334155;
    padding: 1.25rem;
    border-radius: 10px;
  }

  .edu-highlight {
    border-left: 4px solid #38bdf8;
  }

  .edu-item-year {
    color: #818cf8;
    font-size: 0.8rem;
    font-weight: 700;
    display: block;
    margin-bottom: 0.25rem;
  }

  .edu-item-title {
    font-size: 1rem !important;
    font-weight: 700 !important;
    color: #ffffff !important;
    margin: 0 0 0.25rem 0 !important;
  }

  .edu-item-inst {
    color: #94a3b8;
    font-size: 0.85rem;
    margin: 0;
  }

  .portfolio-footer {
    border-top: 1px solid #334155;
    padding: 2rem 1.5rem;
    text-align: center;
    color: #94a3b8;
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .nav-links { display: none; }
    .hero-name { font-size: 1.9rem !important; }
  }
</style>
