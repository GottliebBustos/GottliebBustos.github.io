<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="portfolio-body">

  <header class="portfolio-header">
    <nav class="portfolio-nav">
      <a href="#" class="nav-brand">Gottlieb Bustos S.</a>
      <div class="nav-links">
        <a href="#sobre-mi">Sobre Mí</a>
        <a href="#habilidades">Habilidades</a>
        <a href="#experiencia">Experiencia</a>
        <a href="#certificaciones">Certificaciones</a>
        <a href="#formacion">Formación</a>
        <a href="#contacto">Contacto</a>
      </div>
    </nav>
  </header>

  <div class="main-wrapper">
    <!-- Hero -->
    <section class="hero-block">
      <h1 class="hero-name">Gottlieb Bustos Schulze</h1>
      <div class="badge-wrapper">
        <span class="hero-badge">Ingeniero Civil en Informática</span>
      </div>
      <h2 class="hero-role">Analítica de Datos · Control de Gestión TI · Dirección Estratégica</h2>
      <p class="hero-desc">{description}</p>
    </section>

    <!-- Sobre Mí -->
    <section class="content-section" id="sobre-mi">
      <h2 class="heading-decorated">Sobre Mí</h2>
      <div class="about-box">
        <p class="about-paragraph">{aboutText}</p>
      </div>
    </section>

    <!-- Habilidades -->
    <section class="content-section" id="habilidades">
      <h2 class="heading-decorated">Habilidades Clave</h2>
      <div class="skills-grid">
        {skills.map((skill) => (
          <div class="skill-item">
            <i class={`fa-solid ${skill.icon}`}></i>
            <span>{skill.name}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Experiencia -->
    <section class="content-section" id="experiencia">
      <h2 class="heading-decorated">Experiencia Laboral</h2>
      <div class="timeline-container">
        {experiences.map((exp) => (
          <div class="timeline-entry">
            <div class="timeline-card-box">
              <span class="timeline-badge">{exp.period}</span>
              <h3 class="timeline-card-title">{exp.role}</h3>
              <p class="timeline-card-org">{exp.org}</p>
              <ul class="timeline-bullets">
                {exp.achievements.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Certificaciones -->
    <section class="content-section" id="certificaciones">
      <div class="section-header-flex">
        <div>
          <h2 class="heading-decorated">Licencias & Certificaciones</h2>
          <p class="section-hint">Haz clic en el título de una certificación para abrir y visualizar el certificado en PDF.</p>
        </div>
        <a href="https://www.linkedin.com/in/gottlieb-bustos-schulze-34a289142/details/certifications/" target="_blank" rel="noopener noreferrer" class="link-external">
          Ver en LinkedIn <i class="fa-solid fa-arrow-up-right-from-square"></i>
        </a>
      </div>
      <div class="cert-grid">
        {certifications.map((cert) => (
          <div class="cert-item-box cert-interactive">
            <div class="cert-icon-wrap">
              <i class="fa-solid fa-award"></i>
            </div>
            <div class="cert-details">
              <button 
                type="button" 
                class="doc-trigger-btn" 
                data-file={cert.file}
                data-name={cert.name}
                data-issuer={cert.issuer}
              >
                <span>{cert.name}</span>
                <i class="fa-solid fa-file-pdf cert-doc-icon" title="Ver documento PDF"></i>
              </button>
              <p class="cert-issuer">{cert.issuer}</p>
              <div class="cert-meta">
                <span class="cert-date">Expedición: {cert.date}</span>
                {cert.id && <span class="cert-id">ID: {cert.id}</span>}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Formación Académica & Diplomados (Con visor PDF modal) -->
    <section class="content-section" id="formacion">
      <div class="section-header-flex">
        <div>
          <h2 class="heading-decorated">Formación Académica & Diplomados</h2>
          <p class="section-hint">Haz clic en el título de un grado o diplomado para abrir su diploma/certificado en PDF.</p>
        </div>
      </div>
      <div class="edu-card-grid">
        {education.map((edu) => (
          <div class={`edu-item-box ${edu.highlight ? 'edu-highlight' : ''} ${edu.file ? 'edu-interactive' : ''}`}>
            <span class="edu-item-year">{edu.year}</span>
            {edu.file ? (
              <button 
                type="button" 
                class="doc-trigger-btn edu-title-btn" 
                data-file={edu.file}
                data-name={edu.title}
                data-issuer={edu.inst}
              >
                <span>{edu.title}</span>
                <i class="fa-solid fa-file-pdf cert-doc-icon" title="Ver diploma PDF"></i>
              </button>
            ) : (
              <h3 class="edu-item-title">{edu.title}</h3>
            )}
            <p class="edu-item-inst">{edu.inst}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Contacto al Final -->
    <section class="content-section" id="contacto">
      <h2 class="heading-decorated">Contacto</h2>
      <div class="contact-panel">
        <p class="contact-intro">Disponible para nuevos desafíos profesionales y consultas técnicas.</p>
        <div class="contact-grid">
          <a href={contact.linkedin} target="_blank" rel="noopener noreferrer" class="contact-pill contact-pill-linkedin">
            <i class="fa-brands fa-linkedin"></i> <span>LinkedIn</span>
          </a>
          <a href={`mailto:${contact.email}`} class="contact-pill">
            <i class="fa-solid fa-envelope"></i> <span>{contact.email}</span>
          </a>
          <a href={`tel:${contact.phone.replace(/\s+/g, '')}`} class="contact-pill">
            <i class="fa-solid fa-phone"></i> <span>{contact.phone}</span>
          </a>
          <span class="contact-pill">
            <i class="fa-solid fa-location-dot"></i> <span>{contact.location}</span>
          </span>
          <span class="contact-pill">
            <i class="fa-solid fa-language"></i> <span>{contact.languages}</span>
          </span>
        </div>
      </div>
    </section>
  </div>

  <!-- Modal Visor Unificado de PDFs (Certificados y Títulos) -->
  <div class="modal-backdrop" id="doc-modal" aria-hidden="true">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <h3 id="modal-title" class="modal-title">Documento</h3>
          <p id="modal-issuer" class="modal-subtitle"></p>
        </div>
        <div class="modal-actions">
          <a id="modal-download" href="#" target="_blank" class="modal-btn" title="Abrir / Descargar PDF">
            <i class="fa-solid fa-up-right-from-square"></i>
          </a>
          <button id="modal-close" type="button" class="modal-btn modal-close-btn" aria-label="Cerrar">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>
      </div>
      <div class="modal-body" id="modal-body">
        <!-- Iframe del PDF inyectado dinámicamente -->
      </div>
    </div>
  </div>

  <footer class="portfolio-footer">
    <p>© 2026 Gottlieb Bustos Schulze · Portafolio Profesional</p>
  </footer>

  <script>
    const modal = document.getElementById('doc-modal');
    const modalTitle = document.getElementById('modal-title');
    const modalIssuer = document.getElementById('modal-issuer');
    const modalBody = document.getElementById('modal-body');
    const modalDownload = document.getElementById('modal-download') as HTMLAnchorElement;
    const modalClose = document.getElementById('modal-close');

    function openModal(file: string, name: string, issuer: string) {
      if (!modal || !modalBody || !modalTitle || !modalIssuer || !modalDownload) return;

      modalTitle.textContent = name;
      modalIssuer.textContent = issuer;
      modalDownload.href = file;

      modalBody.innerHTML = '';
      const iframe = document.createElement('iframe');
      iframe.src = file;
      iframe.className = 'modal-iframe';
      modalBody.appendChild(iframe);

      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal || !modalBody) return;
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      modalBody.innerHTML = '';
      document.body.style.overflow = '';
    }

    // Escucha eventos tanto de certificados como de formación académica
    document.querySelectorAll('.doc-trigger-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const file = btn.getAttribute('data-file');
        const name = btn.getAttribute('data-name');
        const issuer = btn.getAttribute('data-issuer');
        if (file && name && issuer) {
          openModal(file, name, issuer);
        }
      });
    });

    modalClose?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  </script>

</body>
</html>

<style is:global>
  html, body.portfolio-body {
    margin: 0 !important;
    padding: 0 !important;
    background-color: #0f172a !important;
    color: #f8fafc !important;
    font-family: 'Inter', sans-serif !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }

  *, *::before, *::after {
    box-sizing: border-box !important;
  }

  .portfolio-header {
